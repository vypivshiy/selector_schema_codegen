(raw)struct PlayerScript {
    @doc "Extract Playerjs config from inline <script>."

    playlist_url {
        re #"Playerjs\([^)]*file:\s*[\"']([^\"']+)[\"']"#
    }

    player_id {
        re #"Playerjs\([^)]*id:\s*[\"']([^\"']+)[\"']"#
    }
}

(raw)struct AnimeParams {
    @doc "Parse ?dubbing_code=Sanae&anime_id=339&episode=1"

    dubbing_code {
        split "?"
        index 1
        split "&"
        filter { starts "dubbing_code=" }
        index 0
        rm-prefix "dubbing_code="
    }

    anime_id {
        split "?"
        index 1
        split "&"
        filter { starts "anime_id=" }
        index 0
        rm-prefix "anime_id="
        to-int
    }

    episode {
        split "?"
        index 1
        split "&"
        filter { starts "episode=" }
        index 0
        rm-prefix "episode="
        to-int
    }
}

(raw)struct M3u8Playlist {
    @doc "Parse m3u8-style playlist: [480p]/path/01_480p.m3u8"

    @split-doc {
        split "\n"
    }

    quality {
        re #"\[(\d+p)\]"#
    }

    url {
        re #"\](.+)"#
    }
}

(raw)struct CsvLines {
    @split-doc {
        split "\n"
    }

    @init {
        parts {
            split ","
        }
    }

    col_0 {
        @parts
        index 0
    }

    col_1 {
        @parts
        index 1
    }
}

(raw)struct RemotePlaylist {
    @doc "Fetch a .txt playlist file and extract the first stream URL."

    @request """
    curl {{playlist_url}}
    """

    stream_url {
        re #"^(https?://[^\s]+)"#
    }
}
