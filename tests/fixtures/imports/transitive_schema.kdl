// Level2Item keeps its private RE-PRICE dependency. FMT-BASE is used locally
// and therefore must be imported directly (imports are not re-exported).
import "./level2.kdl" { (struct)Level2Item }
import "./shared_defines.kdl" { (define)FMT-BASE }

struct TransitivePage {
    url {
        css "a"
        attr "href"
        fmt FMT-BASE
    }
    item { nested Level2Item }
}
