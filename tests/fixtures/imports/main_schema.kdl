import "./shared_defines.kdl" {
    (define)FMT-BASE
    (define)RE-PRICE
    (define)STRIP-PREFIX
}
import "./shared_struct.kdl" {
    (struct)SharedItem
}

struct Page {
    url {
        css "a"
        attr "href"
        STRIP-PREFIX
        fmt FMT-BASE
    }
    price {
        css ".price"
        text
        re RE-PRICE
        to-float
    }
    item { nested SharedItem }
}
