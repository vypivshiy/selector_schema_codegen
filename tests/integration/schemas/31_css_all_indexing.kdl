// Regression: css-all returns *goquery.Selection which is not directly
// indexable in Go. Index/first/last must emit .Eq(...) instead of [].
struct DocIndexing {
    @doc "first link href — exercises `first` (= Index 0)."
    first_link {
        css-all "a"
        first
        attr href
    }

    @doc "last link href — exercises `last` (= Index -1)."
    last_link {
        css-all "a"
        last
        attr href
    }

    @doc "second link href — exercises positive Index."
    second_link {
        css-all "a"
        index 1
        attr href
    }

    @doc "second-to-last link href — exercises negative Index."
    penultimate_link {
        css-all "a"
        index -2
        attr href
    }
}
