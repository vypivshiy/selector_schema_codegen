@doc "Focused JSON parse test: extract JSON script, parse full array and single values."

define RE-JSON-ARRAY=#"(\[.*\])"#

json JsonAuthor {
    name str
    slug str
}

(array)json JsonQuote {
    text str
    author JsonAuthor
    tags (array)str
    score int
    rating float
    active bool
    note str?
}

struct JsonBasic {
    @init {
        raw-json {
            css "script#test-data"
            text
            re RE-JSON-ARRAY
        }
    }

    full-payload {
        @raw-json
        jsonify JsonQuote
    }

    first-author-name {
        @raw-json
        jsonify JsonQuote path="0.author.name"
    }

    first-score {
        @raw-json
        jsonify JsonQuote path="0.score"
    }

    first-tags {
        @raw-json
        jsonify JsonQuote path="0.tags"
    }

    second-text {
        @raw-json
        jsonify JsonQuote path="1.text"
    }
}
